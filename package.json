{
  "name": "Lack",
  "desktopName": "Lack.desktop",
  "version": "1.0.0",
  "description": "Editor LaTeX professionale con compilatore, anteprima PDF e collaborazione in tempo reale",
  "main": "main.js",
  "scripts": {
    "build:editor": "node esbuild.config.js",
    "start": "node esbuild.config.js && electron . --no-sandbox",
    "build": "node esbuild.config.js && electron-builder",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "latex",
    "editor",
    "overleaf",
    "tex",
    "math",
    "pdf",
    "collaboration"
  ],
  "author": {
    "name": "Gaetano",
    "email": "gaetanocarbone2004@gmail.com"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/sGabellee/lack.git"
  },
  "devDependencies": {
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@electron/remote": "^2.1.2",
    "@replit/codemirror-vim": "^6.4.0",
    "@retorquere/bibtex-parser": "^13.0.15",
    "@unified-latex/unified-latex-ctan": "^1.8.4",
    "@unified-latex/unified-latex-util-parse": "^1.8.4",
    "adm-zip": "^0.6.1",
    "archiver": "^8.0.0",
    "chokidar": "^6.0.0",
    "dictionary-en": "^4.0.0",
    "dictionary-en-gb": "^3.0.0",
    "dictionary-it": "^2.0.0",
    "electron-updater": "^6.8.9",
    "nspell": "^2.1.5",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "y-codemirror.next": "^0.3.6",
    "y-webrtc": "^10.3.0",
    "yjs": "^13.6.33"
  },
  "build": {
    "appId": "com.Giovanni.Lack",
    "productName": "Lack",
    "executableName": "lack",
    "fileAssociations": [
      {
        "ext": "tex",
        "name": "LaTeX Document",
        "description": "File LaTeX",
        "role": "Editor",
        "icon": "build/lack.png"
      },
      {
        "ext": "bib",
        "name": "BibTeX Bibliography",
        "description": "File BibTeX",
        "role": "Editor",
        "icon": "build/lack.png"
      },
      {
        "ext": "cls",
        "name": "LaTeX Class",
        "description": "File LaTeX Class",
        "role": "Editor",
        "icon": "build/lack.png"
      },
      {
        "ext": "sty",
        "name": "LaTeX Style",
        "description": "File LaTeX Style",
        "role": "Editor",
        "icon": "build/lack.png"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!.vscode/**",
      "!test/**",
      "!docs/**",
      "!scripts/**",
      "!**/*.map",
      "!arXiv-*",
      "!prova*.tex",
      "!lack",
      "!lack.c",
      "!.lack-history/**",
      "!lin-install.sh",
      "!mac-install.sh",
      "!win-install.bat",
      "!PROJECT_RECAP.md"
    ],
    "win": {
      "icon": "build/lack.ico",
      "target": [
        "nsis",
        "zip"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "installerIcon": "build/lack.ico",
      "uninstallerIcon": "build/lack.ico",
      "installerHeaderIcon": "build/lack.ico"
    },
    "mac": {
      "icon": "build/lack.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "icon": "build/lack.png",
      "category": "Utility;TextEditor;Development;Education;",
      "maintainer": "Gaetano <gaetanocarbone2004@gmail.com>",
      "desktop": {
        "entry": {
          "Name": "Lack",
          "GenericName": "LaTeX Editor",
          "Comment": "Lack Professional LaTeX Editor & Suite",
          "MimeType": "application/pdf;text/x-tex;application/x-tex;",
          "StartupWMClass": "lack",
          "Keywords": "latex;tex;editor;overleaf;math;pdf;science;beamer;bibtex;"
        }
      },
      "target": [
        "AppImage",
        "deb",
        "tar.gz",
        "dir"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sGabellee",
        "repo": "lack"
      }
    ]
  }
}
